<?xml version="1.0" encoding="UTF-8"?>
<project>
  <name>fpgui-docview</name>
  <author>Graeme Geldenhuys</author>
  <license>BSD-3-Clause</license>

  <build>
    <projectType>application</projectType>
    <mainSource>docview.lpr</mainSource>
    <executableName>docview</executableName>
  </build>

  <moduleDependencies>
    <module>../framework</module>
  </moduleDependencies>

  <!-- Transitive Wayland backend bindings (see fpgui-ide for rationale). -->
  <dependencies>
    <dependency>
      <name>wayland-classes</name>
      <version>1.0.0</version>
    </dependency>
    <dependency>
      <name>support</name>
      <version>1.0.0</version>
    </dependency>
  </dependencies>

  <test>
    <framework>fpcunit</framework>
    <testSource>TestRunner.pas</testSource>
    <frameworkOptions>
      <option>--all</option>
      <option>--format=plain</option>
    </frameworkOptions>
  </test>

</project>
