<?xml version="1.0" encoding="UTF-8"?>
<project>
  <name>fpgui-framework</name>
  <author>Graeme Geldenhuys</author>
  <license>BSD-3-Clause</license>

  <build>
    <projectType>library</projectType>

    <unitPaths>
      <!-- These act as inclusion rules based on conditions.
           X11 is the DEFAULT backend on UNIX (Linux/BSD) and is always compiled
           with no profile required. It provides the single fpg_interface/fpg_impl
           and registers the X11 backend factory (fpg_x11_backend).
           Building with -p wayland additionally compiles the Wayland units and
           (via fpg_x11_backend's {$ifdef WAYLAND} uses + the -dWAYLAND define
           the profile sets) registers the Wayland factory as a second backend.
           The active backend is then chosen at RUNTIME (see fpg_backend).
           Windows/macOS select their backend by platform automatically. -->
      <path condition="UNIX">corelib/x11</path>
      <path condition="WAYLAND">corelib/wayland</path>
      <path condition="WINDOWS">corelib/gdi</path>
      <path condition="DARWIN">corelib/cocoa</path>
      <!-- There are just to clean up the FPC command - not strictly needed -->
      <path condition="UNUSED">corelib/_template</path>
    </unitPaths>

    <resources>
      <filtering>true</filtering>
    </resources>
  </build>

  <test>
    <framework>fpcunit</framework>
    <testSource>TestRunner.pas</testSource>
    <frameworkOptions>
      <option>--all</option>
      <option>--format=plain</option>
    </frameworkOptions>
  </test>

  <profiles>
    <profile>
      <id>x11</id>
      <defines>
        <define>X11</define>
      </defines>
    </profile>
    <profile>
      <id>wayland</id>
      <!-- WAYLAND (PasBuild condition) pulls in the corelib/wayland unit path. -->
      <defines>
        <define>WAYLAND</define>
      </defines>
      <compilerOptions>
        <!-- -dWAYLAND is the ACTUAL FPC define, so fpg_x11_backend's
             {$ifdef WAYLAND} pulls in the Wayland registrar. -->
        <option>-dWAYLAND</option>
        <option>-g</option>
        <option>-gl</option>
        <option>-gw3</option>
      </compilerOptions>
    </profile>
  </profiles>

  <!-- only because we want the tool for resource compilation -->
  <moduleDependencies>
    <module>../tools/svg2hvif</module>
  </moduleDependencies>

  <!-- The Wayland backend (built with -p wayland) uses the pure-Pascal `wayl`
       binding (wayland-rt + protocol tiers + wayland-classes 0.1.0; no
       libwayland; xkbcommon wrappers live in wayland-rt). These are deliberately
       NOT declared as <dependency> entries — pasbuild resolves dependencies
       unconditionally, which would force every X11/Windows/macOS build to also
       have the Wayland packages installed.

       Instead the prebuilt Wayland units are copied into target/units by the
       `pasbuild wayland-units` plugin (plugins/pasbuild-wayland-units) and ride
       along into the installed framework, so every dependent module inherits
       them. Run it manually before a Wayland build (see that script). X11 builds
       need nothing. -->

</project>
