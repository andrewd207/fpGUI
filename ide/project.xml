<?xml version="1.0" encoding="UTF-8"?>
<project>
  <name>fpgui-ide</name>
  <author>Graeme Geldenhuys</author>
  <license>BSD-3-Clause</license>

  <build>
    <projectType>application</projectType>
    <mainSource>ide.main.pas</mainSource>
    <executableName>maximus</executableName>
  </build>

  <test>
    <testSource>TestRunner.pas</testSource>
    <framework>fpcunit</framework>
    <frameworkOptions>
      <option>--all</option>
      <option>--format=plain</option>
    </frameworkOptions>
  </test>

  <!-- The IDE doesn't conditionally compile on the backend (it goes through
       fpg_interface), but a matching 'wayland' profile lets -p wayland apply
       debug info to the IDE's own units and the final executable, so maximus
       is debuggable (otherwise only the framework units carry debug info and
       the binary ends up stripped). -->
  <profiles>
    <profile>
      <id>wayland</id>
      <compilerOptions>
        <option>-g</option>
        <option>-gl</option>
        <option>-gw3</option>
      </compilerOptions>
    </profile>
  </profiles>

  <moduleDependencies>
    <module>../framework</module>
  </moduleDependencies>

  <!-- Needed transitively: the Wayland framework backend's fpg_impl pulls in
       the Wayland bindings. Unconditional (PasBuild deps have no conditions),
       so the bindings must be installed even for X11 builds. -->
  <dependencies>
    <dependency>
      <name>wayland-classes</name>
      <version>1.0.0</version>
    </dependency>
    <dependency>
      <name>support</name>
      <version>1.0.0</version>
    </dependency>
    <!-- OPDF debugger (FPC 3.3.x): provides pdr_ports etc. for
         ide.debug.adapter. On FPC 3.2.x the IDE uses the no-op stub. -->
    <dependency>
      <name>opdf-lib</name>
      <version>0.3.1</version>
    </dependency>
    <dependency>
      <name>pdr-core</name>
      <version>0.3.1</version>
    </dependency>
    <dependency>
      <name>pdr-adapters</name>
      <version>0.3.1</version>
    </dependency>
  </dependencies>

</project>
